NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR-ANON-KEY"

# Public site URL — used to build magic-link callbacks and QR code targets.
# Use the deployment URL in production; localhost for dev.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Server-only secrets (do NOT expose). Required for server actions
# (posting, moderation, likes, archive rollover).
SUPABASE_SERVICE_ROLE_KEY="service-role-key-here"
SUPABASE_PROJECT_REF="your-project-ref"
IP_HASH_SALT="random-32+chars-for-ip-hash"

# Optional: Slack webhook for moderation/rate-limit notifications.
# SLACK_MODERATION_WEBHOOK_URL=""
